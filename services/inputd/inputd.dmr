# DMOD Resource File for inputd (the input device service)
# This file specifies where resources should be installed

# === Core Module ===
dmf=./${module}.dmf => ${destination}/${module}.dmf [origin=${dmf_dir}/${module}.dmf]
dmfc=./${module}.dmfc => ${destination}/${module}.dmfc [origin=${build_dir}/dmfc/${module}.dmfc]
dmd=./${module}.dmd => ${destination}/${module}.dmd [origin=${dmf_dir}/${module}.dmd]
version=./${module}_version.txt => ${destination}/${module}_version.txt [origin=${dmf_dir}/${module}_version.txt]

# === Documentation ===
# NOTE: ${repo_dir} is the top-level repo root (inputd is built through add_subdirectory() from the
# CMakeLists.txt of the repo), so paths are relative to the repo root, not to services/inputd.
readme=./README.md => ${destination}/${module}/README.md [origin=${repo_dir}/services/inputd/README.md]

# === Configuration files ===
# inputd@.ini (unit template) and inputd.rules (device rule) - used by
# dmf-get's "inputd service=inputd@.ini" / "inputd rules=inputd.rules"
configs=./configs => ${destination}/${module}/configs [origin=${repo_dir}/services/inputd/configs]

# === License ===
license=./LICENSE => ${destination}/${module}/LICENSE [origin=${repo_dir}/LICENSE]

# Adding itself
dmr=./${module}.dmr => ${destination}/${module}/${module}.dmr [origin=${repo_dir}/services/inputd/${module}.dmr]
