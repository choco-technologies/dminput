; inputd.rules - libsystemd device rule.
;
; Every node dmdevfs reports as "input" (it answers the standard input ioctls - see dmdevfs'
; "libsystemd Device Reporting": a touch panel, a keyboard, buttons, a mouse) gets its own
; inputd@<name> instance, instantiated on demand from inputd@.ini.
;
; Load with libsystemd_load_rules() on the directory this file lives in -
; see dmsystem's docs/configuration.md ("Device rules").
[class=input]
start=inputd@%name
